# Copy to `.env.local` for local dev / VM (Vite loads `.env.local` automatically).
# Vite proxies /api to QRP API (default :8010, not Q-TeleScope :8000).
QRP_API_TARGET=http://127.0.0.1:8010
#
# VITE_QRE_ENV=lab|production — UI mode (demo login presets hidden in production).
# VITE_QRE_CAPTCHA=1 — show captcha fields (off by default; must match QRE_CAPTCHA_ENABLED on API).
VITE_QRE_ENV=lab
VITE_QRE_CAPTCHA=0