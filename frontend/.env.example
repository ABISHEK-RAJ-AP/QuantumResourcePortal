# Copy to `.env.local` for local dev / VM (Vite loads `.env.local` automatically).
# The Vite dev server proxies /api to port 8000 — start the QRP API first: `make dev-api` or `bash scripts/vm-setup.sh`.
#
# VITE_QRE_ENV=lab|production — UI mode (demo login presets hidden in production).
# VITE_QRE_CAPTCHA=1|0 — show captcha fields in the SPA; must match QRE_CAPTCHA_ENABLED on API.
VITE_QRE_ENV=lab
VITE_QRE_CAPTCHA=1